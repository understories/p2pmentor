{
  "name": "p2pmentor",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings 2000",
    "lint:fix": "next lint --fix --max-warnings 2000",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "prepare": "husky",
    "perf:network": "tsx scripts/perf/network_page.test.ts",
    "seed:app-feedback": "tsx scripts/seed-app-feedback.ts",
    "build:static-data": "tsx scripts/build-static-data.ts",
    "build:static-html": "tsx scripts/generate-static-html.ts",
    "build:static": "npm run build:static-data && npm run build:static-html",
    "serve:static": "cd static-app/public && python3 -m http.server 8080"
  },
  "dependencies": {
    "@arkiv-network/sdk": "0.6.7",
    "@metamask/sdk": "^0.34.0",
    "@simplewebauthn/server": "^9.0.0",
    "@walletconnect/ethereum-provider": "^2.21.8",
    "graphql": "^16.12.0",
    "graphql-http": "^1.22.4",
    "idb-keyval": "^6.2.1",
    "next": "^15.5.28",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-force-graph-2d": "^1.29.0",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@simplewebauthn/typescript-types": "^8.3.4",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.22",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.11",
    "postcss": "^8.5.31",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@^7": "^7.29.6",
      "@walletconnect/jsonrpc-ws-connection>ws": "^7.5.11",
      "ajv@^6": "^6.14.0",
      "baseline-browser-mapping@^2": "^2.11.0",
      "brace-expansion@^1": "^1.1.21",
      "brace-expansion@^2": "^2.1.7",
      "browserslist@^4": "^4.28.7",
      "defu@^6": "^6.1.5",
      "flatted@^3": "^3.4.2",
      "form-data@^4": "^4.0.6",
      "h3@^1": "^1.15.9",
      "js-yaml@^4": "^4.3.2",
      "linkify-it@^5": "^5.0.2",
      "lodash-es@^4": "^4.18.0",
      "lodash@^4": "^4.18.0",
      "markdown-it@^14": "^14.3.3",
      "minimatch@^3": "^3.1.4",
      "minimatch@^9": "^9.0.7",
      "nanoid@^3": "^3.3.18",
      "picomatch@^2": "^2.3.2",
      "picomatch@^4": "^4.0.4",
      "postcss-selector-parser@^6": "^6.1.3",
      "postcss@^8": "^8.5.23",
      "preact@^10": "^10.28.2",
      "rollup@^4": "^4.59.0",
      "socket.io-parser@^4": "^4.2.7",
      "source-map-js@^1": "^1.2.2",
      "ws@^8": "^8.21.0",
      "yaml@^2": "^2.8.3"
    }
